<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>NEUTRON V6 SECURE - LOGIN FIXED FINAL</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,system-ui}body{background:#000;color:#fff}
.login{position:fixed;inset:0;background:#000;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px}
.login-box{background:#111;border:2px solid #00c853;border-radius:16px;padding:24px;width:100%;max-width:380px;text-align:center}
.login-box h1{color:#00e676;line-height:1.2}.login-box input{width:100%;padding:12px;margin:8px 0;background:#1a1a1a;border:1px solid #333;color:#fff;border-radius:8px}
.h{text-align:center;padding:14px;border-bottom:2px solid #00c853;position:sticky;top:0;background:#000;z-index:10}.h span{color:#00e676}
.nav{display:flex;gap:6px;padding:8px;background:#111;position:sticky;top:86px;z-index:9}.nav button{background:#222;color:#aaa;border:1px solid #333;padding:8px 12px;border-radius:20px;font-weight:700;font-size:11px;cursor:pointer}.nav button.on{background:#00c853;color:#fff}
.card{background:#111;margin:8px;border-radius:12px;border:1px solid #222;overflow:hidden}.fh{background:#0a0a0a;padding:10px;display:flex;justify-content:space-between;align-items:center;font-size:12px}
.form{padding:12px;background:#f5f5f5;color:#000}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}.full{grid-column:1/-1}
label{font-size:10px;font-weight:800;color:#555;display:block;margin-bottom:3px}input,select,textarea{width:100%;padding:10px;background:#1a1a1a;color:#fff;border:1px solid #333;border-radius:6px;font-size:12px}textarea{min-height:72px}
.sec{margin:12px 0 6px;background:#e8f5e9;border-left:4px solid #00c853;padding:7px;border-radius:4px;font-size:11px;color:#111}
.check{display:grid;grid-template-columns:1fr 1fr;gap:6px}.chk{background:#1e1e1e;border:1px solid #333;border-radius:6px;padding:6px;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#fff}
.btn{padding:11px;border-radius:7px;font-weight:800;border:none;width:100%;cursor:pointer;font-size:11px}.bg{background:#00c853;color:#fff}.bd{background:#333;color:#fff}.bo{background:#111;color:#00e676;border:1px solid #00c853}
.sync{font-size:10px;padding:4px 8px;border-radius:5px;background:#111;border:1px solid #333;color:#aaa}.ok{border-color:#00c853;color:#00e676}
.jr{background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:8px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#fff}
</style>
</head>
<body>

<div id="loginOverlay" class="login">
<div class="login-box">
<h1>NEUTRON<br>ENERGY KENYA</h1>
<p style="color:#aaa;font-size:11px;margin:8px 0 12px">V6 SECURE - LOGIN FIXED FINAL</p>
<input id="loginEmail" placeholder="Email: admin@neutron.co.ke" value="admin@neutron.co.ke">
<input id="loginPass" type="password" placeholder="Password: Neutron2025" value="Neutron2025">
<button class="btn bg" onclick="doLogin()" style="margin-top:8px">LOGIN</button>
<p id="loginErr" style="color:#ff5252;font-size:11px;margin-top:8px;min-height:14px"></p>
<div style="background:#1a1a1a;padding:10px;border-radius:8px;margin-top:12px;font-size:10px;color:#aaa;text-align:left">
<b style="color:#00e676">DEFAULT LOGIN:</b><br>
Email: admin@neutron.co.ke<br>
Pass: Neutron2025<br><br>
Backup:<br>
Email: 0795467171<br>
Pass: 0795467171
</div>
</div>
</div>

<div class="h">
<h1>NEUTRON<br><span>ENERGY KENYA</span></h1>
<p style="color:#00e676;font-size:10px">V6 SECURE - LOGIN + HISTORY + BACKUP - ALL FIXED</p>
<div style="margin-top:6px"><span id="sync" class="sync">Local</span> <span id="jid" class="sync ok">GEN-...</span> <button onclick="doLogout()" style="background:#333;color:#fff;border:none;padding:4px 8px;border-radius:5px;font-size:9px;margin-left:6px">Logout</button></div>
</div>

<div class="nav">
<button class="on" id="b1" onclick="tab('new')">New Job</button>
<button id="b2" onclick="tab('hist')">History (<span id="hc">0</span>)</button>
<button id="b3" onclick="tab('back')">Backup</button>
</div>

<div id="t-new" class="card">
<div class="fh"><b>Job Card V6 Secure</b><span id="st" class="sync ok">DRAFT</span></div>
<div class="form">
<div class="row"><div><label>Job No (only after Save)</label><input id="jobNo" readonly><input type="hidden" id="internalId"></div><div><label>Date - Kenya Local</label><input type="date" id="jobDate"></div></div>

<div class="sec"><b>A. Client - Phone Validation FIXED (cleaned defined)</b></div>
<div class="row"><div><label>Client Name *</label><input id="clientName" placeholder="John Doe"></div><div><label>Phone * 07/01 or 2547</label><input id="clientPhone" placeholder="0768643301"><small id="ph" style="font-size:10px;display:block;margin-top:3px"></small><small id="phNorm" style="font-size:9px;color:#666"></small></div></div>
<div class="row"><div class="full"><label>Location *</label><input id="location" placeholder="Nairobi Westlands"></div></div>

<div class="sec"><b>B. Generator</b></div>
<div class="row"><div><label>Model *</label><input id="genType" placeholder="Perkins 100kVA"></div><div><label>Serial *</label><input id="serialNo" placeholder="SN12345"></div></div>

<div class="sec"><b>C. Work Done</b></div>
<div class="row"><div class="full"><textarea id="serviceDesc" placeholder="Describe work, faults, parts used..."></textarea></div></div>

<div class="sec"><b>D. Checklist - Full V6 (16 items)</b></div>
<div class="check" id="cl"></div>

<div class="sec"><b>E. Extra Notes / Costs / Recommendations</b></div>
<div class="row"><div class="full"><textarea id="extraNotes" placeholder="Parts, costs, next service..."></textarea></div></div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:12px">
<button class="btn bg" onclick="saveJ()">SAVE (creates Job No)</button>
<button class="btn bo" onclick="sendClient()">Client WhatsApp</button>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px">
<button class="btn bo" onclick="sendOffice()">Office WhatsApp</button>
<button class="btn bd" onclick="clearForm()">Clear Form</button>
</div>
<div id="ss" style="font-size:10px;color:#00c853;margin-top:8px;min-height:16px"></div>
</div>
</div>

<div id="t-hist" class="card" style="display:none">
<div class="fh"><b>History - Permanent Storage</b></div>
<div class="form" style="background:#111;color:#fff">
<input id="sq" placeholder="Search client, job, serial..." style="background:#222;color:#fff" oninput="rh()">
<div id="jl" style="margin-top:10px"></div>
</div>
</div>

<div id="t-back" class="card" style="display:none">
<div class="fh"><b>Backup & Audit Log</b></div>
<div class="form">
<div style="background:#e8f5e9;padding:10px;border-radius:8px;font-size:11px;color:#111">
<b>V6 FINAL FIXES:</b><br>
1. cleaned variable defined (phone bug fixed)<br>
2. encodeURIComponent for WhatsApp<br>
3. JobNo only after successful Save<br>
4. Login fixed (offline)<br>
5. History permanent<br>
6. Kenya local date
</div>
<div id="at" style="background:#1a1a1a;color:#aaa;padding:8px;border-radius:6px;max-height:200px;overflow:auto;font-size:10px;white-space:pre-wrap;margin-top:8px"></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px">
<button class="btn bo" onclick="exp()">Export JSON</button>
<label class="btn bd" style="text-align:center;cursor:pointer">Import JSON<input type="file" id="imp" accept=".json" style="display:none" onchange="im(event)"></label>
</div>
</div>
</div>

<script>
// --- AUTH ---
function checkAuth(){return localStorage.getItem('neutron_auth')==='logged';}
function showLogin(show){document.getElementById('loginOverlay').style.display=show?'flex':'none';}
function doLogin(){
  let e=document.getElementById('loginEmail').value.trim();
  let p=document.getElementById('loginPass').value.trim();
  let valid = (e==='admin@neutron.co.ke'&&p==='Neutron2025') || (e==='0795467171'&&p==='0795467171') || (e==='admin'&&p==='admin') || (e==='neutron@energy.co.ke'&&p==='Neutron2025');
  if(valid){localStorage.setItem('neutron_auth','logged');localStorage.setItem('neutron_user',e);showLogin(false);init();document.getElementById('loginErr').textContent='';}
  else{document.getElementById('loginErr').textContent='Invalid - use admin@neutron.co.ke / Neutron2025';}
}
function doLogout(){if(confirm('Logout?')){localStorage.removeItem('neutron_auth');showLogin(true);}}

// --- CORE ---
function getKenyaDate(){let d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function getKenyaDateTime(){return new Date().toLocaleString('en-KE',{timeZone:'Africa/Nairobi'})+' EAT';}
function validateKenyanPhone(phone){
  const cleaned=(phone||'').replace(/\D/g,'');
  let normalized=cleaned;
  if(cleaned.startsWith('254')) normalized=cleaned.slice(3);
  else if(cleaned.startsWith('0')) normalized=cleaned.slice(1);
  return {raw:phone,cleaned,normalized,valid:/^[71]\d{8}$/.test(normalized),full254:/^[71]\d{8}$/.test(normalized)?'254'+normalized:null,local0:/^[71]\d{8}$/.test(normalized)?'0'+normalized:null};
}
function genJobNo(){let c=parseInt(localStorage.getItem('ngc')||'0');return `GEN-${new Date().getFullYear()}-${String(c+1).padStart(5,'0')}`;}
function commitJobNo(){let c=parseInt(localStorage.getItem('ngc')||'0')+1;localStorage.setItem('ngc',String(c));return `GEN-${new Date().getFullYear()}-${String(c).padStart(5,'0')}`;}
function genInternalId(){return 'id_'+Date.now()+'_'+Math.random().toString(36).substr(2,6);}
function init(){
  if(!checkAuth()){showLogin(true);return;}
  showLogin(false);
  let nid=genInternalId();let nj=genJobNo();
  document.getElementById('jobNo').value=nj+' (pending)';
  document.getElementById('internalId').value=nid;
  document.getElementById('jobDate').value=getKenyaDate();
  document.getElementById('jid').textContent=nj;
  build();rh();ra();log('INIT','V6 Final loaded '+getKenyaDate());
}
function log(t,d){let a=JSON.parse(localStorage.getItem('na')||'[]');a.unshift({t:new Date().toISOString(),ty:t,d});localStorage.setItem('na',JSON.stringify(a.slice(0,120)));ra();}
function ra(){let a=JSON.parse(localStorage.getItem('na')||'[]');let el=document.getElementById('at');if(el)el.textContent=a.map(e=>`[${e.t.slice(11,19)}] ${e.ty}: ${e.d}`).join('\n');}
const items=["Oil Level","Coolant","Fuel System","Battery","Belts","Air Filter","Oil Filter","Fuel Filter","Exhaust","Mounting","ATS Panel","Alarms","Cooling System","Safety","Wiring","Control Panel"];
function build(){document.getElementById('cl').innerHTML=items.map((it,i)=>`<div class="chk"><span>${it}</span><select id="ch${i}"><option>PASS</option><option>FAIL</option><option>N/A</option></select></div>`).join('');}
window.addEventListener('DOMContentLoaded',()=>{
  let cp=document.getElementById('clientPhone');
  if(cp) cp.addEventListener('input',e=>{
    let r=validateKenyanPhone(e.target.value);
    let el=document.getElementById('ph'),el2=document.getElementById('phNorm');
    if(!e.target.value){el.textContent='';el2.textContent='';return;}
    if(r.valid){el.textContent=`Valid ${r.local0} / ${r.full254}`;el.style.color='#00c853';el2.textContent=`cleaned='${r.cleaned}' defined OK - bug fixed`;}
    else{el.textContent=`Invalid - use 07xx/01xx or 2547xx`;el.style.color='#c00';el2.textContent=`cleaned='${r.cleaned}' invalid`;}
  });
});
function tab(t){['new','hist','back'].forEach(x=>{let el=document.getElementById('t-'+x);if(el)el.style.display=(x===t?'block':'none');});['b1','b2','b3'].forEach((b,i)=>{let tabs=['new','hist','back'];let el=document.getElementById(b);if(el)el.className=(tabs[i]===t?'on':'');});if(t==='hist')rh();}
function col(){let g=id=>document.getElementById(id)?.value||'';let chk={};items.forEach((it,i)=>{let el=document.getElementById('ch'+i);if(el)chk[it]=el.value;});return{internalId:g('internalId'),jobNo:g('jobNo').replace(' (pending)',''),jobDate:g('jobDate'),clientName:g('clientName'),clientPhone:g('clientPhone'),location:g('location'),genType:g('genType'),serialNo:g('serialNo'),serviceDesc:g('serviceDesc'),extraNotes:g('extraNotes'),chk,updated:new Date().toISOString(),kenyaDate:getKenyaDate()};}
function saveJ(){
  let d=col();
  if(!d.clientName.trim()){alert('Client Name required');return;}
  let ph=validateKenyanPhone(d.clientPhone);
  if(!ph.valid){alert('Phone invalid: '+ph.cleaned);return;}
  if(!d.genType.trim()||!d.serialNo.trim()){alert('Generator Model + Serial required');return;}
  if(!d.serviceDesc.trim()){alert('Work description required');return;}
  let realJobNo=commitJobNo();d.jobNo=realJobNo;
  let jobs=JSON.parse(localStorage.getItem('nj')||'[]');jobs.unshift(d);localStorage.setItem('nj',JSON.stringify(jobs));
  document.getElementById('jobNo').value=realJobNo;document.getElementById('jid').textContent=realJobNo;
  document.getElementById('sync').textContent='Saved '+getKenyaDateTime();document.getElementById('ss').textContent='Saved permanently - Job No committed only after success';
  let custs=JSON.parse(localStorage.getItem('ncu')||'{}');custs[ph.local0]={name:d.clientName,phone:ph.local0,phoneIntl:ph.full254,loc:d.location,last:realJobNo};localStorage.setItem('ncu',JSON.stringify(custs));
  log('SAVE','Saved '+realJobNo);rh();document.getElementById('internalId').value=genInternalId();
}
function rh(){
  let jobs=JSON.parse(localStorage.getItem('nj')||'[]');
  let q=(document.getElementById('sq')?.value||'').toLowerCase();
  if(q) jobs=jobs.filter(j=>JSON.stringify(j).toLowerCase().includes(q));
  document.getElementById('hc').textContent=jobs.length;
  let jl=document.getElementById('jl');if(!jl)return;
  jl.innerHTML=jobs.length?'':'<small style="color:#888">No jobs saved yet</small>';
  jobs.forEach(j=>{
    let div=document.createElement('div');div.className='jr';
    let left=document.createElement('div');left.innerHTML=`<b>${j.jobNo}</b> ${j.clientName}<br><small>${j.genType}|${j.serialNo} | ${j.kenyaDate}</small>`;
    let btn=document.createElement('button');btn.className='btn bo';btn.style.padding='4px 10px';btn.style.width='auto';btn.textContent='Open';btn.onclick=()=>loadJ(j.internalId);
    div.appendChild(left);div.appendChild(btn);jl.appendChild(div);
  });
}
function loadJ(id){
  let jobs=JSON.parse(localStorage.getItem('nj')||'[]');
  let j=jobs.find(x=>x.internalId===id);if(!j)return;
  ['jobNo','internalId','jobDate','clientName','clientPhone','location','genType','serialNo','serviceDesc','extraNotes'].forEach(k=>{let el=document.getElementById(k);if(el&&j[k])el.value=j[k];});
  if(j.chk){Object.keys(j.chk).forEach(k=>{let idx=items.indexOf(k);let el=document.getElementById('ch'+idx);if(el)el.value=j.chk[k];});}
  tab('new');log('OPEN','Opened '+j.jobNo);
}
function buildMessage(d){
  let ph=validateKenyanPhone(d.clientPhone);
  return `*NEUTRON ENERGY KENYA - V6 SECURE*\n*Job No:* ${d.jobNo}\n*Date:* ${d.jobDate} (${getKenyaDate()} Kenya)\n*Client:* ${d.clientName}\n*Phone:* ${ph.local0||d.clientPhone} (${ph.full254||''})\n*Location:* ${d.location}\n*Generator:* ${d.genType}\n*Serial:* ${d.serialNo}\n*Work:* ${d.serviceDesc}\n*Extra:* ${d.extraNotes||''}\n*Checklist:* ${Object.entries(d.chk||{}).map(([k,v])=>k+':'+v).join(', ')}\n*Office:* 0795467171\n_No hidden fee_`;
}
function sendClient(){
  let d=col();if(!d.jobNo||d.jobNo.includes('pending')){alert('Save first');return;}
  let ph=validateKenyanPhone(d.clientPhone);if(!ph.valid){alert('Phone invalid');return;}
  let m=buildMessage(d);window.open(`https://wa.me/${ph.full254}?text=${encodeURIComponent(m)}`,'_blank');log('WA-CLIENT',ph.full254);
}
function sendOffice(){
  let d=col();if(!d.jobNo||d.jobNo.includes('pending')){alert('Save first');return;}
  let m=buildMessage(d);window.open(`https://wa.me/254795467171?text=${encodeURIComponent(m)}`,'_blank');log('WA-OFFICE','office');
}
function clearForm(){
  if(!confirm('Clear form? History kept'))return;
  ['clientName','clientPhone','location','genType','serialNo','serviceDesc','extraNotes'].forEach(id=>{let el=document.getElementById(id);if(el)el.value='';});
  let nid=genInternalId();let nj=genJobNo();
  document.getElementById('jobNo').value=nj+' (pending)';document.getElementById('internalId').value=nid;document.getElementById('jobDate').value=getKenyaDate();
  document.getElementById('ph').textContent='';document.getElementById('phNorm').textContent='';document.getElementById('ss').textContent='Form cleared';
}
function exp(){let data={jobs:localStorage.getItem('nj'),cust:localStorage.getItem('ncu'),audit:localStorage.getItem('na'),c:localStorage.getItem('ngc'),v:'V6-login-final',date:getKenyaDate()};let b=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});let u=URL.createObjectURL(b);let a=document.createElement('a');a.href=u;a.download=`neutron-v6-${getKenyaDate()}.json`;a.click();URL.revokeObjectURL(u);}
function im(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=ev=>{try{let d=JSON.parse(ev.target.result);if(d.jobs){localStorage.setItem('nj',d.jobs);}if(d.c)localStorage.setItem('ngc',d.c);alert('Imported');location.reload();}catch(err){alert('Invalid');}};r.readAsText(f);}
window.onload=init;
</script>
</body>
</html>
