<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>LOGIN TEST</title><style>body{background:#000;color:#fff;font-family:Arial;display:flex;align-items:center;justify-content:center;height:100vh}.box{background:#111;border:2px solid #00c853;border-radius:16px;padding:24px;width:90%;max-width:360px;text-align:center}input{width:100%;padding:12px;margin:8px 0;background:#222;border:1px solid #333;color:#fff;border-radius:8px}button{width:100%;padding:12px;background:#00c853;color:#fff;border:none;border-radius:8px;font-weight:800;margin-top:8px}</style></head><body>
<div class="box"><h2 style="color:#00e676">NEUTRON LOGIN TEST</h2><p style="font-size:11px;color:#aaa;margin:8px 0">V6 TEST - If this works, main bug is elsewhere</p><input id="e" value="admin@neutron.co.ke"><input id="p" type="password" value="Neutron2025"><button onclick="login()">LOGIN</button><p id="err" style="color:#ff5252;font-size:11px;margin-top:8px"></p><p id="ok" style="color:#00e676;font-size:11px;margin-top:8px"></p></div>
<script>
function login(){
  try{
    let email=document.getElementById('e').value.trim();
    let pass=document.getElementById('p').value.trim();
    document.getElementById('err').textContent='Trying... '+email;
    let valid = (email==='admin@neutron.co.ke'&&pass==='Neutron2025') || (email==='0795467171'&&pass==='0795467171') || (email==='admin'&&pass==='admin');
    if(valid){
      localStorage.setItem('neutron_auth','logged');
      document.getElementById('ok').textContent='SUCCESS! Login works! Auth saved: '+localStorage.getItem('neutron_auth');
      document.getElementById('err').textContent='';
      setTimeout(()=>{alert('LOGIN SUCCESS! Now we can load full V6');},500);
    }else{
      document.getElementById('err').textContent='FAIL: '+email+' / '+pass+' not matched';
    }
  }catch(err){
    document.getElementById('err').textContent='JS ERROR: '+err.message;
    alert('Error: '+err.message);
  }
}
window.onload=()=>{document.getElementById('ok').textContent='Page loaded OK, localStorage available: '+(typeof localStorage!=='undefined');}
</script></body></html>
